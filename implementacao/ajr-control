#!/usr/bin/env python3
"""Send a command to a registered AJR session from the GUI or Shell bar."""
import json
import sys
from core import RUNTIME_DIR
from x11 import X11

def main():
    pid = int(sys.argv[1])
    command = {'fullscreen': 1, 'restore': 2, 'minimize': 3,
               'disconnect': 4, 'toggle': 5}[sys.argv[2]]
    session = json.loads((RUNTIME_DIR / f'session-{pid}.json').read_text())
    if session['pid'] != pid:
        raise RuntimeError('Identificação de sessão inválida.')
    x11 = X11()
    try:
        x11.control(pid, session['token'], command)
    finally:
        x11.close()

if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, OSError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
