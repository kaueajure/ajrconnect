# Keep only the upstream X11 frontend/resources needed by this build.
/implementacao/native/vendor/*
!/implementacao/native/vendor/FreeRDP-2.11.5/
/implementacao/native/vendor/FreeRDP-2.11.5/*
!/implementacao/native/vendor/FreeRDP-2.11.5/LICENSE
!/implementacao/native/vendor/FreeRDP-2.11.5/client/
!/implementacao/native/vendor/FreeRDP-2.11.5/resources/
/implementacao/native/vendor/FreeRDP-2.11.5/client/*
!/implementacao/native/vendor/FreeRDP-2.11.5/client/.gitignore
!/implementacao/native/vendor/FreeRDP-2.11.5/client/X11/

# Required development headers; no .deb packages, libraries or SDK metadata.
/implementacao/native/sdk/*
!/implementacao/native/sdk/usr/
/implementacao/native/sdk/usr/*
!/implementacao/native/sdk/usr/include/
/implementacao/native/sdk/usr/include/*
!/implementacao/native/sdk/usr/include/freerdp2/
!/implementacao/native/sdk/usr/include/winpr2/

# Tests that do not need local credentials, reports, captures or VM access.
/implementacao/tests/*
!/implementacao/tests/test_compatibility.py
!/implementacao/tests/test_distribution.py
!/implementacao/tests/test_bootstrap.py
!/implementacao/tests/test_dependencies.py
!/implementacao/tests/test_preferences.py
!/implementacao/tests/test_updates.py
!/implementacao/tests/test_reconnect.py
!/implementacao/tests/test_integration_update.py
!/implementacao/tests/test_keyboard_portal.py
!/implementacao/tests/check_portal_session.py
!/implementacao/tests/check_live_update.py
!/implementacao/tests/check_desktop_ui.py
!/implementacao/tests/check_keyboard_policy.py
!/implementacao/tests/keyboard_policy.c

# Ignore generated or personal files even inside allowed source directories.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.log
*.deb
*.o
*.so
*.so.*
*.swp
*.swo
*~
.DS_Store
